# Neon PostgreSQL 18 (https://neon.tech — free tier)
# Dashboard → Connect → Prisma → copie as URLs abaixo
# connect_timeout evita P1001 no cold start do compute hibernado
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"

# Same Neon database and BETTER_AUTH_SECRET as daviandradedev-auth.
# The app library stays on DATABASE_URL. Sessions live only on AUTH_DATABASE_URL.
AUTH_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
BETTER_AUTH_SECRET="same-secret-as-the-auth-hub"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3100,http://localhost:3000,https://auth.daviandrade.dev,https://seriesaholic.daviandrade.dev"
# Leave empty on localhost. Production on *.daviandrade.dev uses .daviandrade.dev.
BETTER_AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_URL="https://auth.daviandrade.dev"
